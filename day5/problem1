# counting digits only

jumble = input("Enter the mixture of strings , digits , symbols : " )

j_list = list(jumble)
#print(j_list)
list_length = [x for x in j_list if x.isdigit()]
#print(list_length)
#digit_count = sum(1 for x in j_list if x.isdigit())

digit_count = 0
for char in j_list :
    if char.isdigit():
        digit_count += 1
print(f"Total digits in the input : {digit_count} and are as follows :\n {list_length}")