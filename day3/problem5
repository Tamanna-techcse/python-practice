words = input("enter the word to count the vowels :\n")
vowels = ['a' , 'e' , 'i' , 'o' , 'u']
def vowel_count(word):
    text = word.lower()
    nvowel = [x for x in text if x in vowels]
    print(f"list of vowels present in the word {words} is :" , nvowel)
    print(f"total vowels in the word {words} are =", len(nvowel))
vowel_count(words)
print()

