def find_largest(numbers) :
    if isinstance(numbers , str) :
        nums = list(map(int, numbers.split()))
    else :
        nums = list(map(int , numbers))
    if not nums :
        raise ValueError("invalid syntax provide valid input")
    largest = nums[0]
    for num in nums:
        if num > largest:
            largest = num
    return largest
print("The largest number among the provided numbers is =", find_largest(numbers))
print()


def find_smallest(numbers) :
    if isinstance(numbers , str) :
        nums = list(map(int, numbers.split()))
    else :
        nums = list(map(int , numbers))
    if not nums :
        raise ValueError("invalid syntax provide valid input")
    smallest = nums[0]
    for num in nums:
        if num < smallest :
            smallest = num
    return smallest
print("The smallest number among the provided numbers is =", find_smallest(numbers))
print()


