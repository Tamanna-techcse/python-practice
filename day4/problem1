# second largest number function 
def second_largest(numbers) :
    unique_numbers = list(set(numbers))
    unique_numbers.sort(reverse=True)
    return unique_numbers[1] if len(unique_numbers) >= 2 else None

# Example usage
list_numbers = list(map(int, input("Enter numbers separated by space: ").split()))
print("Second largest number is:", second_largest(list_numbers))